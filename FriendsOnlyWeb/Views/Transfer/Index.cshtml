@using Application.ViewModels.Transfer
@model TransferVM

<div class="main-dashboard">
    <h1 class="text-center">Transfer</h1>

    <!-- Formulario de pago expreso -->
    <form asp-action="Index" method="post" id="TranferForm">
        @if (Model?.from != null && Model.from.Any())
        {
            <div class="mb-3">
                <label for="DestinationAccountId" class="form-label">Cuenta de Destino</label>
                <select class="form-select" asp-for="DestinationAccountId"
                        asp-items="@(Model.from.Select(a => new SelectListItem { Value = a.Id.ToString(), Text = $"{a.Id} - {a.Balance}" }))" required>
                    <option value="">Seleccione una cuenta</option>
                </select>
                <span asp-validation-for="DestinationAccountId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="amount" class="form-label">Monto</label>
                <input type="number" class="form-control" asp-for="Amount" id="amount" placeholder="Ingrese el monto" min="1" step="0.01" required />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            @if (Model?.To != null && Model.To.Any())
            {
                <div class="mb-3">
                    <label for="SourceAccountId" class="form-label">Cuenta de Origen</label>
                    <select class="form-select" asp-for="SourceAccountId"
                            asp-items="@(Model.To.Select(a => new SelectListItem { Value = a.Id.ToString(), Text = $"{a.Id} - {a.Balance:C}" }))" required>
                        <option value="">Seleccione una cuenta</option>
                    </select>
                    <span asp-validation-for="SourceAccountId" class="text-danger"></span>
                </div>

            }
            else
            {
                <p>No hay cuentas disponibles.</p>
            }

            <div class="text-center">
                <button type="submit" class="btn btn-primary w-100">Realizar Pago</button>
            </div>
        }
        else
        {
            <p>NO hay cuantas disponibles para hacer esta transaccion</p>
        }


    </form>
</div>

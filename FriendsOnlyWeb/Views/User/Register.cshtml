@inject IHttpContextAccessor httpcontext;
@using Application.DTOs.UserDtos
@using Application.Helpers;
@using Application.ViewModels.User;
@using Application.Enums
@{
    var user = httpcontext.HttpContext?.Session.Get<AuthenticationResponse>("user");
}
@using Application.ViewModels.User;
@model SaveUserViewModel

@{
    bool Editmode = Model.Id == null ? false : true;
    Layout = null;
    ViewData["Title"] = Editmode ? "Update" : "Register";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@500&display=swap" rel="stylesheet">
    @if (user != null)
    {
        <!-- Estilos para cuando el usuario está logueado -->
        <link rel="stylesheet" href="~/css/LoggedIn.css" asp-append-version="true" />
    }
    else
    {
        <!-- Estilos para cuando el usuario no está logueado -->
        <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        label {
        font-size: 12px;
        font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="main @if (user != null) {
    <text>dashboard</text>
        }
    ">
        <div class="login @if (user != null) {
        <text>dashboard-form</text>
                }
        ">
            <form method="post" asp-controller="User" asp-action="Register" enctype="multipart/form-data">
                @if (Editmode)
                {
                    <label style="font-size: 16px;">Update</label>
                }
                else
                {
                    <label style="font-size: 16px;">Register</label>
                }

                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                @if (Model.HasError)
                {
                    <div class="alert alert-danger" role="alert">
                        <p>@Model.Error</p>
                    </div>
                }

                <label asp-for="FirstName" class="control-label">First Name</label>
                <input asp-for="FirstName" type="text" placeholder="First Name" class="form-control">
                <span class="text-danger">@Html.ValidationMessageFor(m => m.FirstName)</span>

                <label asp-for="LastName" class="control-label">Last Name</label>
                <input asp-for="LastName" type="text" placeholder="Last Name" class="form-control">
                <span class="text-danger">@Html.ValidationMessageFor(m => m.LastName)</span>

                <label asp-for="UserName" class="control-label">Username</label>
                <input asp-for="UserName" type="text" placeholder="Username" class="form-control">
                <span class="text-danger">@Html.ValidationMessageFor(m => m.UserName)</span>

                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" type="email" placeholder="Email" class="form-control">
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Email)</span>

                <label asp-for="Password" class="control-label">Password</label>
                <input asp-for="Password" type="password" placeholder="Password" class="form-control">
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Password)</span>

                <label asp-for="ConfirmPassword" class="control-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" class="form-control">
                <span class="text-danger">@Html.ValidationMessageFor(m => m.ConfirmPassword)</span>

                <label asp-for="Phone" class="control-label">Phone Number</label>
                <input asp-for="Phone" type="tel" placeholder="Phone Number" class="form-control">
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Phone)</span>
                @if (!Editmode)
                {
                    <select asp-for="Roles" class="form-control" onchange="this.form.submit()">
                        <option value="">Seleccione un rol</option>
                        <option value="Admin">Admin</option>
                        <option value="Client">Client</option>
                    </select>
                    <span class="text-danger">@Html.ValidationMessageFor(m => m.Roles)</span>
                }
                @if (Editmode)
                {
                    bool hasIt = user.Roles.Any(role => role == Roles.Client.ToString());
                        @if (Model.Roles == Roles.Client)
                    {
                        <div>
                            <label asp-for="Balance" class="control-label">Balance</label>
                            <input asp-for="Balance" placeholder="Ingrese el balance" class="form-control" />
                            <span class="text-danger">@Html.ValidationMessageFor(m => m.Balance)</span>
                        </div>
                    }
                }
                else
                {
                        @if ( Model.Roles == Roles.Client)
                        {
                                <div>
                                    <label asp-for="Balance" class="control-label">Balance</label>
                                    <input asp-for="Balance" placeholder="Ingrese el balance" class="form-control" />
                                    <span class="text-danger">@Html.ValidationMessageFor(m => m.Balance)</span>
                                </div>
                        }
                }

                <input type="hidden" asp-for="Id" />

                @if (Editmode)
                {
                    <button type="submit" class="btn btn-primary" formaction="@Url.Action("Update", "User")">
                        Update
                    </button>
                }
                else
                {
                    @if (user != null)
                    {
                        <button type="submit" class="btn btn-success" formaction="@Url.Action("Register", "User")">
                            Add User
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-success" formaction="@Url.Action("Register", "User")">
                            Register
                        </button>
                    }
                }

                <div class="button-group">
                    @if (Editmode)
                    {
                        <button type="button" onclick="window.history.back();" class="btn btn-secondary">Back</button>
                    }
                    else
                    {
                        @if (user != null)
                        {
                            <button type="button" onclick="window.location.href='@Url.Action("AdministrationUsers", "User")'" class="btn btn-secondary">Back </button>
                        }
                        else
                        {
                            <button type="button" onclick="window.location.href='@Url.Action("Index", "User")'" class="btn btn-secondary">Back to Login</button>
                        }
                    }
                </div>
            </form>
        </div>
    </div>
</body>
</html>




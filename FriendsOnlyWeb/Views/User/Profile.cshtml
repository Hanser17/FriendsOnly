@using Application.ViewModels.User;
@model SaveUserViewModel

@{
    Layout = "_Layout";
    ViewBag.Title = "Profile";
}

<link href="https://fonts.googleapis.com/css2?family=Jost:wght@500&display=swap" rel="stylesheet">

<style>
   
    .profile-card {
        font-family: 'Jost', sans-serif;
        background: #ffffff;
        border-radius: 15px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        padding: 20px;
        max-width: 800px;
        margin: auto;
    }

    .profile-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .profile-picture {
        border-radius: 50%;
        border: 3px solid #f1f1f1;
        width: 150px;
        height: 150px;
    }

    .profile-info p {
        margin: 0;
        font-size: 16px;
        color: #333;
    }

    .profile-info strong {
        font-size: 18px;
    }

    .btn-edit {
        background: #ffc107;
        color: #000;
        border: none;
        padding: 8px 15px;
        font-weight: bold;
        border-radius: 5px;
        cursor: pointer;
    }

        .btn-edit:hover {
            background: #ffb300;
        }
</style>

<div class="container mt-4">
    <div class="profile-card">
        <div class="profile-header">
            
            <div class="profile-info">
              <div>
                <h2 class="text-black">@Model.UserName</h2>
                <button class="btn-edit" onclick="location.href='@Url.Action("Update", "User", new { userName = Model.UserName })'">
                    Edit
                </button>
           
              </div>
            <div>
                    <p><strong>Nombre:</strong> @Model.FirstName @Model.LastName</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Teléfono:</strong> @Model.Phone</p>

            </div>
          
          </div>
        </div>
    </div>
</div>



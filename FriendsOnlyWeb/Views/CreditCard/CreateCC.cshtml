@using Application.ViewModels.CreditCard
@model CreditCardSaveVM

@{
    ViewData["Title"] = "Crear Tarjeta de credito";
}


<div class="container-fluid d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="card shadow-lg border-0 rounded" style="width: 400px;">
        <div class="card-header bg-primary text-white rounded-top">
            <h2 class="text-center mb-0">Crear Tarjeta de credito</h2>
        </div>
        <div class="card-body">
            <form method="post" class="needs-validation" novalidate>
                <div class="mb-4">
                    <label asp-for="CreditLimit" class="form-label fw-bold text-dark">Limite de la tarjeta de Credito:</label>
                    <input type="number" asp-for="CreditLimit" class="form-control form-control-lg rounded" step="0.01" required />
                    <span class="text-danger" asp-validation-for="CreditLimit"></span>
                </div>

                <input type="hidden" asp-for="UserId" />

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-success px-5 py-2 rounded-pill shadow-sm">Crear Credit Card</button>
                    <button type="button" onclick="window.location.href='@Url.Action("AdministrationUsers", "User")'" class="btn btn-outline-secondary px-5 py-2 rounded-pill">Volver</button>
                </div>
            </form>
            @section Scripts {
                <partial name="_ValidationScriptsPartial" />
            }
        </div>
    </div>
</div>
